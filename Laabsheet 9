bool executeUserRegistration() {
    cout << "\n--- PROFILE REGISTRATION SUBSYSTEM ---\n";
    string targetUser, targetPassword;
    cout << "Enter unique username (no spaces allowed): ";
    cin >> targetUser;
    
    
    for (int i = 0; i < userCount; i++) {
        if (users[i].username == targetUser) {
            cout << "Error: Username already registered!\nPress Enter...";
            cin.ignore(); cin.get();
            return false;
        }
    }
    
    cout << "Enter account security password: ";
    cin >> targetPassword;
    
    if (userCount < MAX_USERS) {
        users[userCount].username = targetUser;
        users[userCount].password = targetPassword;
        users[userCount].monthlyBudget = 0.0; // डिफ़ॉल्ट बजट 0 सेट होगा
        userCount++;
        cout << "Account registered successfully!\nPress Enter to log in...";
        cin.ignore(); cin.get();
        return true;
    }
    cout << "Error: System storage full!\n";
    return false;
}


bool executeUserLogin() {
    cout << "\n--- IDENTITY AUTHENTICATION GATEWAY ---\n";
    string inputUser, inputPassword;
    cout << "Username: ";
    cin >> inputUser;
    cout << "Password: ";
    cin >> inputPassword;
    
    for (int i = 0; i < userCount; i++) {
        if (users[i].username == inputUser && users[i].password == inputPassword) {
            loggedInUser = inputUser;
            return true;
        }
    }
    cout << "Access Denied: Invalid username or password.\nPress Enter...";
    cin.ignore(); cin.get();
    return false;
}
