// Module 12:
void loadDataFromFiles() {
    userCount = 0;
    expenseCount = 0;
    
    ifstream userReader(USER_FILE);
    if (userReader.is_open()) {
        while (userReader >> users[userCount].username 
                          >> users[userCount].password 
                          >> users[userCount].monthlyBudget) {
            userCount++;
            if (userCount >= MAX_USERS) break;
        }
        userReader.close();
    }
    
    ifstream expenseReader(EXPENSE_FILE);
    if (expenseReader.is_open()) {
        while (expenseReader >> expenses[expenseCount].username 
                            >> expenses[expenseCount].date 
                            >> expenses[expenseCount].category 
                            >> expenses[expenseCount].amount) {
            expenseReader.ignore(); 
            getline(expenseReader, expenses[expenseCount].description);
            expenseCount++;
            if (expenseCount >= MAX_EXPENSES) break;
        }
        expenseReader.close();
    }
}
ा
void saveDataToFiles() {
    ofstream userWriter(USER_FILE, ios::trunc);
    for (int i = 0; i < userCount; i++) {
        userWriter << users[i].username << " " 
                   << users[i].password << " " 
                   << users[i].monthlyBudget << "\n";
    }
    userWriter.close();
    
    ofstream expenseWriter(EXPENSE_FILE, ios::trunc);
    for (int i = 0; i < expenseCount; i++) {
        expenseWriter << expenses[i].username << " " 
                      << expenses[i].date << " " 
                      << expenses[i].category << " " 
                      << expenses[i].amount << " " 
                      << expenses[i].description << "\n";
    }
    expenseWriter.close();
}

